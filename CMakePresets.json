{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x64",
      "inherits": "base",
      "displayName": "x64",
      "description": "From an x64 developer shell, or Visual Studio.",
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "arm64",
      "inherits": "base",
      "displayName": "ARM64",
      "description": "From an x64_arm64 or arm64 developer shell, or Visual Studio.",
      "architecture": { "value": "arm64", "strategy": "external" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64", "configuration": "Release" },
    { "name": "arm64-debug", "configurePreset": "arm64", "configuration": "Debug" },
    { "name": "arm64-release", "configurePreset": "arm64", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
