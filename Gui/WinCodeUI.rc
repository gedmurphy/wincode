#include <windows.h>
#include "Resource.h"

IDI_WINCODE ICON "WinCode.ico"

IDD_USERCODES DIALOGEX 0, 0, 320, 236
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Your codes"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Your codes", IDC_UC_HEADING, 7, 7, 306, 10
    LTEXT           "WinCode reads the #defines in each header for NTSTATUS codes, HRESULTs, Win32 errors and pool tags, and reads a header again whenever it changes.",
                    IDC_STATIC, 7, 20, 306, 18
    CONTROL         "", IDC_UC_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
                    7, 42, 306, 84
    LTEXT           "&Treat plain numbers as:", IDC_STATIC, 7, 134, 84, 9
    COMBOBOX        IDC_UC_TREATAS, 93, 132, 110, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Remove", IDC_UC_REMOVE, 263, 131, 50, 14
    EDITTEXT        IDC_UC_DETAILS, 7, 150, 306, 58, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Add file...", IDC_UC_ADD, 7, 215, 56, 14
    PUSHBUTTON      "&Open folder", IDC_UC_FOLDER, 67, 215, 56, 14
    PUSHBUTTON      "Re&load", IDC_UC_RELOAD, 127, 215, 50, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 263, 215, 50, 14
END

IDD_NOTE DIALOGEX 0, 0, 260, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Note"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_NOTE_LABEL, 7, 7, 246, 10, SS_NOPREFIX | SS_ENDELLIPSIS
    EDITTEXT        IDC_NOTE_TEXT, 7, 20, 246, 84, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Shown whenever this code is looked up. Leave it empty to remove it.",
                    IDC_STATIC, 7, 110, 136, 18
    DEFPUSHBUTTON   "OK", IDOK, 149, 111, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 111, 50, 14
END

//
// A heading rather than a group box: a themed group box draws its caption in
// the theme's own colour, which is unreadable in dark mode.
//
IDD_SETTINGS DIALOGEX 0, 0, 280, 322
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WinCode settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Popup hotkey", IDC_SETTINGS_HEADING, 7, 7, 266, 10
    LTEXT           "Opens the popup from any program, with a code on the clipboard already looked up.",
                    IDC_STATIC, 7, 20, 266, 16
    CONTROL         "&Win", IDC_HOTKEY_WIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 40, 32, 12
    CONTROL         "&Ctrl", IDC_HOTKEY_CTRL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 43, 40, 32, 12
    CONTROL         "&Alt", IDC_HOTKEY_ALT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 79, 40, 28, 12
    CONTROL         "S&hift", IDC_HOTKEY_SHIFT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 111, 40, 34, 12
    LTEXT           "+", IDC_STATIC, 149, 42, 8, 8
    COMBOBOX        IDC_HOTKEY_KEY, 159, 39, 60, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_HOTKEY_STATUS, 7, 57, 266, 18
    CONTROL         "&Start WinCode when I sign in", IDC_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    7, 80, 266, 12
    LTEXT           "It then waits in the notification area, so the hotkey works from sign-in.",
                    IDC_STATIC, 19, 93, 254, 9
    CONTROL         "Check GitHub for a new &version once a day", IDC_UPDATECHECK, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 7, 108, 266, 12
    LTEXT           "Codes to show", IDC_SOURCES_HEADING, 7, 128, 266, 10
    CONTROL         "", IDC_SOURCES_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
                    7, 141, 266, 96
    LTEXT           "Sh&ow it:", IDC_STATIC, 7, 245, 34, 9
    COMBOBOX        IDC_SOURCE_SHOW, 43, 243, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Restore defaults", IDC_SOURCES_RESET, 207, 242, 66, 14
    PUSHBUTTON      "C&lear recent lookups", IDC_CLEAR_RECENT, 7, 262, 84, 14
    PUSHBUTTON      "&Your codes...", IDC_USERCODES, 207, 262, 66, 14
    LTEXT           "", IDC_SETTINGS_PATH, 7, 282, 266, 17, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 169, 302, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 302, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     WINCODE_VERSION_MAJOR, WINCODE_VERSION_MINOR, WINCODE_VERSION_PATCH, 0
PRODUCTVERSION  WINCODE_VERSION_MAJOR, WINCODE_VERSION_MINOR, WINCODE_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ged Murphy"
            VALUE "FileDescription", "WinCode"
            VALUE "FileVersion", WINCODE_VERSION_STRING
            VALUE "InternalName", "WinCodeUI"
            VALUE "LegalCopyright", "Copyright (c) 2026 Ged Murphy. GPLv3 or later."
            VALUE "OriginalFilename", "WinCodeUI.exe"
            VALUE "ProductName", "WinCode"
            VALUE "ProductVersion", WINCODE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
